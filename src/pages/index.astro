  <script>
    // Keep anchor offsets equal to the real sticky-header height (it wraps on small screens).
    const header = document.querySelector('header');
    if (header) {
      const setHeaderHeight = () =>
        document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
      new ResizeObserver(setHeaderHeight).observe(header);
      setHeaderHeight();
    }

    // "Open now" badge, computed in India time regardless of the visitor's zone.
    const status = document.getElementById('open-status');
    if (status) {
      const hours: { opens: string; closes: string }[] = JSON.parse(status.dataset.hours ?? '[]');
      const toMin = (t: string) => {
        const [h, m] = t.split(':').map(Number);
        return h * 60 + m;
      };
      const update = () => {
        const parts = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Asia/Kolkata',
          hour: '2-digit',
          minute: '2-digit',
          hourCycle: 'h23',
        }).formatToParts(new Date());
        const get = (type: string) => Number(parts.find((p) => p.type === type)?.value);
        const now = get('hour') * 60 + get('minute');
        const open = hours.some((h) => now >= toMin(h.opens) && now < toMin(h.closes));
        status.dataset.open = String(open);
        status.querySelector('[data-label]')!.textContent = open
          ? 'ఇప్పుడు తెరిచి ఉంది'
          : 'ప్రస్తుతం మూసి ఉంది';
        status.hidden = false;
      };
      update();
      setInterval(update, 60_000);
    }

    // Map facade: swap in the Google Maps iframe on first tap.
    const map = document.getElementById('map');
    map?.querySelector('[data-map-load]')?.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = map.dataset.src!;
      iframe.title = map.dataset.title!;
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      map.replaceChildren(iframe);
      iframe.focus();
    });
  </script>

